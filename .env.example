# Copy to .env — never commit real secrets.
NODE_ENV=development
# --- apps/api & apps/worker only (never expose to frontends) ---
MONGODB_URI=mongodb://127.0.0.1:27117/assar?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6380
SESSION_SECRET=change-me-min-32-chars-change-me-min-32
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=assar-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
N8N_SERVICE_TOKEN=
# --- frontends (public values only) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# --- API ---
PORT=4000
# Min 32 chars. Used to derive CSRF tokens.
# MFA secrets are encrypted with a key derived from this. Min 32 chars; use a different value from SESSION_SECRET.
MFA_ENCRYPTION_KEY=change-me-too-min-32-chars-change-me-too
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
REGISTRATION_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=10
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24
LOG_LEVEL=info
