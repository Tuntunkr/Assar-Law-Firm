# Copy to .env — never commit real secrets.
NODE_ENV=development
# --- apps/api & apps/worker only (never expose to frontends) ---
MONGODB_URI=mongodb://127.0.0.1:27117/assar?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6380
SESSION_SECRET=change-me-min-32-chars-change-me-min-32
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
N8N_SERVICE_TOKEN=
# --- frontends (public values only) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# --- API ---
PORT=4000
# Min 32 chars. Used to derive CSRF tokens.
# MFA secrets are encrypted with a key derived from this. Min 32 chars; use a different value from SESSION_SECRET.
MFA_ENCRYPTION_KEY=change-me-too-min-32-chars-change-me-too
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
REGISTRATION_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=10
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24
LOG_LEVEL=info

# --- Document storage & scanning (apps/api) ---
# Dev: local disk with signed URLs. Production must use s3 (any S3-compatible private bucket) and clamav.
PUBLIC_API_URL=http://localhost:4000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assar-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=104857600
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
# clamav | disabled. "disabled" is rejected in production and marks files "skipped" (never "clean").
SCAN_PROVIDER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Job queue & AI ---
# REDIS_URL is shared by the API and the worker. QUEUE_PREFIX must match on both.
QUEUE_PREFIX=assar
# API: turns the /v1/ai endpoints on. The worker must also have Grok credentials.
AI_ENABLED=false
AI_MAX_ACTIVE_JOBS_PER_ORG=5
AI_JOB_MAX_ATTEMPTS=3
SCAN_JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# --- Worker (apps/worker). Grok credentials exist ONLY here; never in the API or any frontend. ---
WORKER_HEALTH_PORT=4100
WORKER_HEALTH_HOST=127.0.0.1
# Leave GROK_API_KEY empty to run the worker without AI. GROK_MODEL is required when a key is set; no model is assumed.
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
GROK_TIMEOUT_MS=120000
AI_MAX_CONTEXT_CHARS=120000
SCAN_CONCURRENCY=4
AI_CONCURRENCY=2

# --- Workflow automation (n8n) ---
# API: publish events (matter.created, document.scan_clean, ai.output_ready) for the worker to deliver.
WORKFLOWS_ENABLED=false
# mock records an in-app delivery and does not open a network connection.
# whatsapp_cloud uses the Cloud API adapter and still sends nothing until the four values below are set.
# Leave unconfigured so approval stops at the external activation gate.
MESSAGE_PROVIDER=unconfigured
# Required only if the mock webhook should accept callbacks. Do not invent a value.
MESSAGE_WEBHOOK_SECRET=
# Graph version from Meta's send-messages curl (page updated 4 Nov 2026), which uses v27.0.
# Change this only to the version in a later official curl.
WHATSAPP_GRAPH_VERSION=v27.0
# From the firm's own Meta app. Leave empty. Do not paste a live token into a shared file.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RETRY_BASE_MS=200
# Worker: where n8n's webhooks live, WITHOUT the event name, e.g. https://n8n.example.com/webhook/assar
# Events go to <base>/<event-with-dashes>, e.g. .../matter-created. Use https:// in production.
N8N_WEBHOOK_BASE_URL=
# Shared secret (min 16 chars). Sent in X-Assar-Webhook-Token and used to HMAC-sign each delivery.
# Put the same value in the n8n "Assar webhook token" credential.
N8N_WEBHOOK_SECRET=

# --- Client portal (apps/client-portal) ---
VITE_API_URL=http://localhost:4000
